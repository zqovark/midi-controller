<Window x:Class="XMidi.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:XMidi"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="X-MIDI" Width="900" Height="760" MinWidth="620" MinHeight="460"
        Background="#121212" Foreground="#BEBEBE" FontFamily="Tahoma" FontSize="12" WindowStyle="None" WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
    <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="32" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="10" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <SolidColorBrush x:Key="Metal" Color="#121212"/>
        <SolidColorBrush x:Key="KeyMetal" Color="#E68E0D"/>
        <SolidColorBrush x:Key="PanelMetal" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="Muted" Color="#8A8A8D"/>
        <Style x:Key="Display" TargetType="Border"><Setter Property="Background" Value="#121212"/><Setter Property="BorderBrush" Value="#090909"/><Setter Property="BorderThickness" Value="2,2,1,1"/><Setter Property="CornerRadius" Value="2"/><Setter Property="Padding" Value="10,6"/></Style>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#BEBEBE"/></Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#121212"/><Setter Property="Background" Value="{StaticResource KeyMetal}"/>
            <Setter Property="Padding" Value="14,9"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="#E68E0D" BorderThickness="1,1,1,2" CornerRadius="3" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                </Border><ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#F59E0B"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#FFFFFF"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#F59E0B"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#BEBEBE"/><Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
                <Grid>
                    <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                        <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="#0D0D0D" BorderBrush="#333333" BorderThickness="1" CornerRadius="2" Padding="12"><TextBlock HorizontalAlignment="Right" Text="⌄"/></Border></ControlTemplate></ToggleButton.Template>
                    </ToggleButton>
                    <ContentPresenter Margin="12,0,28,0" VerticalAlignment="Center" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}"/>
                    <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
                        <Border Background="#0D0D0D" BorderBrush="#333333" BorderThickness="1" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                            <ScrollViewer MaxHeight="240"><ItemsPresenter/></ScrollViewer>
                        </Border>
                    </Popup>
                </Grid>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#BEBEBE"/><Setter Property="Padding" Value="10"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Item" Background="#0D0D0D" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="#631E1E"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="Background" Value="#631E1E"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{StaticResource PanelMetal}"/><Setter Property="CornerRadius" Value="7"/><Setter Property="Padding" Value="16"/><Setter Property="BorderBrush" Value="#333333"/><Setter Property="BorderThickness" Value="1,2,1,1"/></Style>
        <Style x:Key="Pad" TargetType="Border"><Setter Property="Background" Value="{StaticResource Metal}"/><Setter Property="BorderBrush" Value="#333333"/><Setter Property="BorderThickness" Value="2"/><Setter Property="CornerRadius" Value="24"/><Setter Property="Width" Value="46"/><Setter Property="Height" Value="46"/></Style>
        <Style TargetType="Slider"><Setter Property="Foreground" Value="#E68E0D"/><Setter Property="Background" Value="#333333"/></Style>
        <Style TargetType="ProgressBar"><Setter Property="Height" Value="7"/><Setter Property="Maximum" Value="100"/><Setter Property="Background" Value="#333333"/><Setter Property="Foreground" Value="#E68E0D"/><Setter Property="BorderThickness" Value="0"/></Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <TextBlock x:Name="ControllerStatus" Text="Aguardando controle" VerticalAlignment="Center" Margin="8"/>
                <Button Content="_" Click="MinimizeClicked" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                <Button Content="×" Click="CloseClicked" Margin="5,0,0,0" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
            </StackPanel>
            <TextBlock Text="X–MIDI" Foreground="#E68E0D" FontWeight="Bold" FontSize="20"/>
        </DockPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <Border Style="{StaticResource Card}"><StackPanel>
                <TextBlock x:Name="PerformanceStatus" FontSize="17" Foreground="#E68E0D" TextWrapping="Wrap"/>
                <TextBlock x:Name="PerformanceHint" Margin="0,8,0,0" TextWrapping="Wrap"/>
                <WrapPanel Margin="0,10,0,0">
                    <Button Content="Menu · Play / Stop" Click="PlayPauseClicked" Margin="0,0,8,8"/>
                    <Button Content="View · Comandos" Click="PanelClicked" Margin="0,0,8,8"/>
                    <Button Content="Stop / Silenciar" Click="SilenceClicked" Margin="0,0,8,8"/>
                    <Button x:Name="BankButton" Click="BankClicked" Margin="0,0,8,8"><TextBlock x:Name="BankLabel" Foreground="#121212"/></Button>
                </WrapPanel>
            </StackPanel></Border>
            <Border x:Name="CommandPanel" Style="{StaticResource Card}" Visibility="Collapsed" Margin="0,10,0,0">
                <StackPanel>
                    <TextBlock Text="COMANDOS · ↑/↓ navega · ←/→ escolhe · A confirma · B volta" TextWrapping="Wrap" Foreground="#E68E0D"/>
                    <ListBox x:Name="CommandList" Background="#121212" Foreground="#BEBEBE" BorderThickness="0" IsHitTestVisible="False" Focusable="False" Margin="0,10,0,0">
                        <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="6"/></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock x:Name="MapA" FontSize="16" TextWrapping="Wrap" Margin="4"/><TextBlock x:Name="MapB" FontSize="16" TextWrapping="Wrap" Margin="4"/></StackPanel>
                <StackPanel Grid.Column="1"><TextBlock x:Name="MapX" FontSize="16" TextWrapping="Wrap" Margin="4"/><TextBlock x:Name="MapY" FontSize="16" TextWrapping="Wrap" Margin="4"/></StackPanel>
            </Grid>
            <TextBlock x:Name="DedicatedReadout" Foreground="#E68E0D" Margin="4,8" TextWrapping="Wrap"/>
            <WrapPanel><TextBlock x:Name="VelocityReadout" Margin="4,4,20,4"/><TextBlock x:Name="RepeatReadout" Margin="4" Foreground="#E68E0D"/></WrapPanel>
            <TextBlock Text="Repeat livre · BPM manual · não acompanha a fase do FL" Foreground="#8A8A8D" Margin="4"/>
            <Viewbox Stretch="Uniform" MaxHeight="270">                        <Canvas Width="620" Height="370">
                            <Path Fill="{StaticResource Metal}" Stroke="#333333" StrokeThickness="2" Data="M 125,65 C 75,65 60,110 43,175 L 15,285 C 5,340 60,358 91,318 L 150,255 L 468,255 L 527,318 C 560,358 615,340 603,285 L 578,175 C 560,110 545,65 495,65 Z"/>
                            <Border x:Name="LB" Canvas.Left="107" Canvas.Top="46" Width="125" Height="24" Background="#2A2A2A" CornerRadius="8"><TextBlock Text="LB · KICK" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11"/></Border>
                            <Border x:Name="RB" Canvas.Left="388" Canvas.Top="46" Width="125" Height="24" Background="#2A2A2A" CornerRadius="8"><TextBlock Text="RB · REPEAT" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11"/></Border>
                            <TextBlock x:Name="LTLabel" Canvas.Left="110" Canvas.Top="0" Text="LT 0%" Foreground="#8A8A8D"/><ProgressBar x:Name="LTBar" Canvas.Left="110" Canvas.Top="23" Width="120"/>
                            <TextBlock x:Name="RTLabel" Canvas.Left="390" Canvas.Top="0" Text="RT 0%" Foreground="#8A8A8D"/><ProgressBar x:Name="RTBar" Canvas.Left="390" Canvas.Top="23" Width="120"/>
                            <Ellipse Canvas.Left="267" Canvas.Top="85" Width="86" Height="55" Fill="#0D0D0D" Stroke="#333333"/>
                            <TextBlock Canvas.Left="285" Canvas.Top="103" Text="MIDI" Foreground="#E68E0D" FontWeight="Bold" FontSize="17"/>
                            <Border x:Name="Back" Canvas.Left="246" Canvas.Top="153" Width="34" Height="24" CornerRadius="10" Background="#2A2A2A"><TextBlock Text="▣" HorizontalAlignment="Center"/></Border>
                            <Border x:Name="Start" Canvas.Left="339" Canvas.Top="153" Width="34" Height="24" CornerRadius="10" Background="#2A2A2A"><TextBlock Text="☰" HorizontalAlignment="Center"/></Border>
                            <Canvas Canvas.Left="113" Canvas.Top="104" Width="100" Height="100">
                                <Ellipse Width="100" Height="100" Fill="#121212" Stroke="#333333" StrokeThickness="2"/>
                                <Ellipse x:Name="LeftPuck" Canvas.Left="29" Canvas.Top="29" Width="42" Height="42" Fill="#333333" Stroke="#E68E0D" StrokeThickness="2"/>
                            </Canvas>
                            <Canvas Canvas.Left="355" Canvas.Top="211" Width="100" Height="100">
                                <Ellipse Width="100" Height="100" Fill="#121212" Stroke="#333333" StrokeThickness="2"/>
                                <Ellipse x:Name="RightPuck" Canvas.Left="29" Canvas.Top="29" Width="42" Height="42" Fill="#333333" Stroke="#BEBEBE" StrokeThickness="2"/>
                            </Canvas>
                            <Border x:Name="DPadUp" Canvas.Left="213" Canvas.Top="211" Width="28" Height="30" Background="#2A2A2A" CornerRadius="5"><TextBlock Text="↑" HorizontalAlignment="Center"/></Border>
                            <Border x:Name="DPadDown" Canvas.Left="213" Canvas.Top="265" Width="28" Height="30" Background="#2A2A2A" CornerRadius="5"><TextBlock Text="↓" HorizontalAlignment="Center"/></Border>
                            <Border x:Name="DPadLeft" Canvas.Left="185" Canvas.Top="239" Width="30" Height="28" Background="#2A2A2A" CornerRadius="5"><TextBlock Text="←" HorizontalAlignment="Center"/></Border>
                            <Border x:Name="DPadRight" Canvas.Left="239" Canvas.Top="239" Width="30" Height="28" Background="#2A2A2A" CornerRadius="5"><TextBlock Text="→" HorizontalAlignment="Center"/></Border>
                            <Border x:Name="PadY" Style="{StaticResource Pad}" Canvas.Left="466" Canvas.Top="94"><TextBlock Text="Y" Foreground="#FFC107" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                            <Border x:Name="PadX" Style="{StaticResource Pad}" Canvas.Left="420" Canvas.Top="140"><TextBlock Text="X" Foreground="#BEBEBE" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                            <Border x:Name="PadB" Style="{StaticResource Pad}" Canvas.Left="512" Canvas.Top="140"><TextBlock Text="B" Foreground="#D35F5F" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                            <Border x:Name="PadA" Style="{StaticResource Pad}" Canvas.Left="466" Canvas.Top="186"><TextBlock Text="A" Foreground="#E68E0D" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                            <TextBlock x:Name="LeftEffectLabel" Canvas.Left="112" Canvas.Top="325" MaxWidth="225" TextTrimming="CharacterEllipsis" Text="FILTRO · CC 74" Foreground="#E68E0D" FontSize="12"/>
                            <TextBlock x:Name="RightEffectLabel" Canvas.Left="355" Canvas.Top="325" MaxWidth="225" TextTrimming="CharacterEllipsis" Text="EFEITO · CC 91" Foreground="#BEBEBE" FontSize="12"/>
                        </Canvas>
</Viewbox>
            <Expander x:Name="Preparation" Header="Preparação / portas / instrumentos / detalhes" Foreground="#E68E0D" Margin="0,10,0,0" Expanded="PreparationOpened">
            <StackPanel Margin="0,12,0,0">
                <TextBlock x:Name="MidiStatus" TextWrapping="Wrap"/>
                <TextBlock Text="Aplicativo → FL (saída)" Margin="0,8,0,4"/>
                <ComboBox x:Name="Ports" SelectionChanged="PortSelected"/>
                <TextBlock Text="FL → aplicativo (retorno, porta distinta)" Margin="0,8,0,4"/>
                <ComboBox x:Name="FeedbackPorts" SelectionChanged="FeedbackSelected"/>
                <Button Content="Atualizar portas" Click="RefreshClicked" Margin="0,8"/>
                <TextBlock Text="Canais globais no Channel Rack (contagem a partir de 1): Drum / Sample / Chord" TextWrapping="Wrap"/>
                <WrapPanel Margin="0,8"><TextBox x:Name="DrumChannel" Width="60"/><TextBox x:Name="SampleChannel" Width="60" Margin="8,0"/><TextBox x:Name="ChordChannel" Width="60"/>
                    <Button Content="Aplicar canais" Click="ChannelsClicked" Margin="8,0"/></WrapPanel>
                <CheckBox x:Name="RecordingPrepared" Foreground="#BEBEBE" Checked="RecordingPreparationChanged" Unchecked="RecordingPreparationChanged">
                    <TextBlock Text="Conferi no FL: Blend ligado, filtro Notes, 4/4, destino nativo e envelopes/cortes dos pads" TextWrapping="Wrap"/>
                </CheckBox>
                <TextBlock x:Name="BankDescription" Margin="0,10"/>
                <TextBlock x:Name="ModeCaption"/><TextBlock x:Name="MappingTitle"/>
                <ComboBox x:Name="ModeSelector" SelectionChanged="ModeSelectionChanged"><ComboBoxItem Content="Drum Mode"/><ComboBoxItem Content="Sample Mode"/><ComboBoxItem Content="Chord Mode"/></ComboBox>
                <local:MusicalModePanel x:Name="ModePanel"/>
                <Button Content="Editar mapeamento…" Click="ConfigureClicked" Margin="0,8"/>
                <TextBlock x:Name="DefaultVelocityLabel"/><Slider x:Name="DefaultVelocitySlider" Minimum="1" Maximum="127" Value="110" ValueChanged="DrumValueChanged"/>
                <TextBlock x:Name="MinimumVelocityLabel"/><Slider x:Name="MinimumVelocitySlider" Minimum="1" Maximum="127" Value="30" ValueChanged="DrumValueChanged"/>
                <ComboBox x:Name="VelocityCurveSelector" SelectionChanged="DrumSelectionChanged"><ComboBoxItem Content="Linear"/><ComboBoxItem Content="Suave"/><ComboBoxItem Content="Acentuada"/></ComboBox>
                <StackPanel x:Name="DrumRepeatControls" Margin="0,10">
                    <CheckBox x:Name="RepeatEnabled" Content="NOTE REPEAT" Foreground="#E68E0D" Checked="RepeatEnabledChanged" Unchecked="RepeatEnabledChanged"/>
                    <ComboBox x:Name="RepeatDivisionSelector" SelectionChanged="DrumSelectionChanged"><ComboBoxItem Content="1/4"/><ComboBoxItem Content="1/8"/><ComboBoxItem Content="1/16"/><ComboBoxItem Content="1/32"/><ComboBoxItem Content="1/8T"/><ComboBoxItem Content="1/16T"/><ComboBoxItem Content="1/32T"/></ComboBox>
                    <TextBlock x:Name="BpmLabel"/><Slider x:Name="BpmSlider" Minimum="20" Maximum="300" Value="120" ValueChanged="DrumValueChanged"/>
                </StackPanel>
                <TextBlock x:Name="SwingValue"/><TextBlock x:Name="SwingStepLabel"/>
                <Slider x:Name="SwingSlider" Minimum="0" Maximum="100" ValueChanged="SwingValueChanged"/>
                <TextBlock x:Name="CommandStatus" TextWrapping="Wrap"/>
                <TextBlock Text="Vincule os CC no FL antes de preparar. Preparar envia 64; depois X ajusta relativamente. Ao trocar modo/conectar, os efeitos ficam desativados." TextWrapping="Wrap" Margin="0,10"/>
                <Button Content="Preparar efeitos vinculados em 64" Click="EffectsClicked"/>
                <TextBlock x:Name="LeftValues"/><TextBlock x:Name="RightValues"/>
                <TextBlock x:Name="MessageCount" Margin="0,10"/>
                <ListBox x:Name="Monitor" Height="140" Background="#121212" Foreground="#BEBEBE" FontFamily="Consolas"/>
            </StackPanel>
            </Expander>
            <TextBlock x:Name="SettingsStatus" Text="←/→ banco · ↑/↓ Repeat · Menu transporte · View painel / manter 700 ms emergência" TextWrapping="Wrap" Margin="0,12" Foreground="#8A8A8D"/>
        </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
